# Copy to ../.env.eks and replace every placeholder before creating the Secret.
# Percent-encode the username and password as MongoDB URI components.
ME_CONFIG_MONGODB_URL=mongodb://USERNAME:ENCODED_PASSWORD@CLUSTER.cluster-XXXXXXXXXXXX.eu-west-2.docdb.amazonaws.com:27017/?authSource=admin&tls=true&replicaSet=rs0&readPreference=secondaryPreferred&retryWrites=false
ME_CONFIG_BASICAUTH_USERNAME=mongo-express
ME_CONFIG_BASICAUTH_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
ME_CONFIG_SITE_COOKIESECRET=REPLACE_WITH_A_RANDOM_SECRET
ME_CONFIG_SITE_SESSIONSECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET

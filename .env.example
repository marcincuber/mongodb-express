# Copy to .env. Docker --env-file does not expand ${VARIABLE} expressions.
# Connection credentials belong in this URI, separately from the web login.
ME_CONFIG_MONGODB_URL=mongodb://host.docker.internal:27017/?authSource=admin
ME_CONFIG_MONGODB_ENABLE_ADMIN=true
ME_CONFIG_MONGODB_ALLOW_DISK_USE=false
ME_CONFIG_MONGODB_AWS_DOCUMENTDB=false
ME_CONFIG_MONGODB_TLS=false
# This maps to tlsAllowInvalidCertificates: false enables certificate validation.
ME_CONFIG_MONGODB_TLS_ALLOW_CERTS=false
# ME_CONFIG_MONGODB_TLS_CA_FILE=/certs/ca.pem
# ME_CONFIG_MONGODB_TLS_CERT_KEY_FILE=/certs/client.pem
# ME_CONFIG_MONGODB_TLS_CERT_KEY_FILE_PASSWORD=
# ME_CONFIG_MONGODB_URL_FILE=/run/secrets/mongodb-url

ME_CONFIG_BASICAUTH_ENABLED=true
ME_CONFIG_BASICAUTH_USERNAME=mongo-express
ME_CONFIG_BASICAUTH_PASSWORD=REPLACE_WITH_A_RANDOM_PASSWORD
# ME_CONFIG_BASICAUTH=false
# ME_CONFIG_BASICAUTH_FILE=/run/secrets/basic-auth
# ME_CONFIG_BASICAUTH_ENABLED_FILE=/run/secrets/basic-auth-enabled
# ME_CONFIG_BASICAUTH_USERNAME_FILE=/run/secrets/web-username
# ME_CONFIG_BASICAUTH_PASSWORD_FILE=/run/secrets/web-password

# OIDC dependencies are included in the image. Configure these to use OIDC.
# ME_CONFIG_OIDCAUTH_ENABLED=true
# ME_CONFIG_OIDCAUTH_ISSUER=https://identity.example.com
# ME_CONFIG_OIDCAUTH_CLIENTID=
# ME_CONFIG_OIDCAUTH_CLIENTSECRET=
# ME_CONFIG_OIDCAUTH_SECRET=
# ME_CONFIG_OIDCAUTH_BASEURL=https://mongo-express.example.com
# ME_CONFIG_OIDCAUTH_ENABLED_FILE=/run/secrets/oidc-enabled
# ME_CONFIG_OIDCAUTH_ISSUER_FILE=/run/secrets/oidc-issuer
# ME_CONFIG_OIDCAUTH_CLIENTID_FILE=/run/secrets/oidc-client-id
# ME_CONFIG_OIDCAUTH_CLIENTSECRET_FILE=/run/secrets/oidc-client-secret
# ME_CONFIG_OIDCAUTH_SECRET_FILE=/run/secrets/oidc-secret
# ME_CONFIG_OIDCAUTH_BASEURL_FILE=/run/secrets/oidc-base-url

ME_CONFIG_SITE_COOKIESECRET=REPLACE_WITH_A_RANDOM_SECRET
ME_CONFIG_SITE_SESSIONSECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET
ME_CONFIG_SITE_BASEURL=/
ME_CONFIG_HEALTH_CHECK_PATH=/status
ME_CONFIG_REQUEST_SIZE=50mb
ME_CONFIG_DOCUMENTS_PER_PAGE=10
ME_CONFIG_OPTIONS_READONLY=false
ME_CONFIG_OPTIONS_FULLWIDTH_LAYOUT=false
ME_CONFIG_OPTIONS_PERSIST_EDIT_MODE=false
ME_CONFIG_OPTIONS_NO_DELETE=false
ME_CONFIG_OPTIONS_NO_EXPORT=false
ME_CONFIG_OPTIONS_CONFIRM_DELETE=false
ME_CONFIG_OPTIONS_COLLAPSIBLE_JSON=true
ME_CONFIG_SITE_GRIDFS_ENABLED=false
ME_CONFIG_SITE_SSL_ENABLED=false
# ME_CONFIG_SITE_SSL_CRT_PATH=/certs/web.crt
# ME_CONFIG_SITE_SSL_KEY_PATH=/certs/web.key
PORT=8081
VCAP_APP_HOST=0.0.0.0
# VCAP_SERVICES={"mongodb-2.4":[{"credentials":{"connectionString":"mongodb://mongo:27017","tls":false}}]}
